# Copy this file to .env and set your open Meet room.
# cp .env.example .env   (or copy .env.example .env on Windows)

MEET_URL=https://meet.google.com/YOUR-MEET-CODE
BOT_NAME=PC Bot
MODE=chat-only
CHAT_MESSAGE=Hello from the bot
CHAT_INTERVAL_MS=5000
RECORD_SECONDS=60

# false = visible Chrome (recommended on a PC so you can watch join + chat)
HEADLESS=false
WINDOW_SIZE=1280x720
