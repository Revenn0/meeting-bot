{
  "name": "plateia-console",
  "type": "module",
  "version": "2.0.0",
  "description": "Plateia Console — ensaio local com até 15 convidados reais no Google Meet",
  "main": "console/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node console/index.js",
    "console": "node console/index.js",
    "bot:one": "node scripts/run-one-bot.js",
    "fleet:10": "node scripts/run-fleet-live.js --size=10",
    "fleet:15": "node scripts/run-fleet-live.js --size=15",
    "test": "node --test test/*.test.js",
    "benchmark:mock": "node scripts/benchmark-modes.js",
    "benchmark:chromium": "node scripts/benchmark-chromium-profiles.js",
    "loadtest:chat-only": "node scripts/load-test-chat-only.js",
    "fleet:local": "node scripts/run-fleet.js",
    "pack:windows": "node scripts/pack-windows.js"
  },
  "keywords": [
    "google-meet",
    "plateia",
    "chat-only",
    "rehearsal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "puppeteer": "^25.1.0"
  }
